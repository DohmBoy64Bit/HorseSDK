    "void Game_DispatchSdlEvent(GameContext* ctx, SDL_Event* ev) {  // 0xC0430",
    "  // rcx=ctx, rdx=ev \u2014 event.type @ [rdx+0]",
    "  switch (ev->type) {",
    "    case 0x100:  // SDL_QUIT \u2014 cmp @ 0xc043b",
    "    case 0x303:  // SDL_TEXTINPUT \u2014 cmp @ 0xc044f",
    "    case 0x300:  // SDL_KEYDOWN \u2014 cmp @ 0xc0477",
    "    case 0x301:  // SDL_KEYUP \u2014 cmp @ 0xc052c",
    "    case 0x400:  // SDL_WINDOWEVENT \u2014 cmp @ 0xc05a6",
    "    case 0x401:  // SDL_SYSWMEVENT \u2014 cmp @ 0xc05de",
    "    case 0x200:  // SDL_APP_TERMINATING \u2014 cmp @ 0xc06c1",
    "    default: break;",
    "  }",
    "  // call StdString_Assign @ 0xc045a",
    "  // call SDL_GL_GetDrawableSize @ 0xc0704",
    "  // call Game_FrameFinalize @ 0xc0709",
    "}"
