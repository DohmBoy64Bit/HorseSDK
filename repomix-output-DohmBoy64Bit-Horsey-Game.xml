// Hook DLL - hooks SDL_PollEvent to trace main game loop
// Compile with: g++ -shared -o hook.dll hook.cpp

#include <windows.h>
#include <stdio.h>
#include <time.h>

FILE* g_logFile = NULL;
int g_frameCount = 0;
DWORD g_lastLogTime = 0;

// Get original SDL_PollEvent from SDL2.dll
typedef int(*SDL_PollEvent_t)(void*);
SDL_PollEvent_t origSDL_PollEvent = NULL;

// Our hooked SDL_PollEvent
int HookedSDL_PollEvent(void* event) {
    g_frameCount++;
    
    // Log every 60 frames (approx 1 second at 60fps)
    DWORD now = GetTickCount();
    if (now - g_lastLogTime > 1000) {
        if (g_logFile) {
            fprintf(g_logFile, "Frame: %d (1 sec)\n", g_frameCount);
            fflush(g_logFile);
        }
        g_lastLogTime = now;
    }
    
    // Call original
    if (origSDL_PollEvent) {
        return origSDL_PollEvent(event);
    }
    return 0;
}

// Hook using IAT (Import Address Table) - patch the game's import table
bool HookIAT(const char* dllName, const char* funcName, void* hookFunc, void** origFunc) {
    // Get the game's import address for the function
    HMODULE gameBase = GetModuleHandle(NULL);
    
    // Find the import directory
    IMAGE_DOS_HEADER* dosHeader = (IMAGE_DOS_HEADER*)gameBase;
    IMAGE_NT_HEADERS* ntHeaders = (IMAGE_NT_HEADERS*)((BYTE*)gameBase + dosHeader->e_lfanew);
    IMAGE_IMPORT_DESCRIPTOR* importDesc = (IMAGE_IMPORT_DESCRIPTOR*)(
        (BYTE*)gameBase + ntHeaders->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT].VirtualAddress);
    
    // Walk through imports
    for (int i = 0; importDesc[i].Name != 0; i++) {
        const char* dllNameInImport = (const char*)((BYTE*)gameBase + importDesc[i].Name);
        
        // Find the DLL we want to hook
        if (_stricmp(dllNameInImport, dllName) == 0) {
            // Get the thunk list
            IMAGE_THUNK_DATA* thunk = (IMAGE_THUNK_DATA*)(
                (BYTE*)gameBase + importDesc[i].FirstThunk);
            
            // Walk through functions
            for (int j = 0; thunk[j].u1.AddressOfData != 0; j++) {
                // Get function name if ordinal
                if (IMAGE_SNAP_BY_ORDINAL(thunk[j].u1.Ordinal)) continue;
                
                IMAGE_IMPORT_BY_NAME* importName = (IMAGE_IMPORT_BY_NAME*)(
                    (BYTE*)gameBase + thunk[j].u1.AddressOfData);
                
                // Check if this is the function we want
                if (strcmp((char*)importName->Name, funcName) == 0) {
                    // Save original address
                    *origFunc = (void*)thunk[j].u1.Function;
                    
                    // Make memory writable
                    DWORD oldProtect;
                    VirtualProtect(&thunk[j].u1.Function, sizeof(void*), PAGE_READWRITE, &oldProtect);
                    
                    // Patch to our hook
                    thunk[j].u1.Function = (ULONGLONG)hookFunc;
                    
                    VirtualProtect(&thunk[j].u1.Function, sizeof(void*), oldProtect, &oldProtect);
                    
                    return true;
                }
            }
        }
    }
    
    return false;
}

BOOL WINAPI DllMain(HINSTANCE hinstDLL, DWORD fdwReason, LPVOID lpvReserved) {
    if (fdwReason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(hinstDLL);
        
        char logPath[MAX_PATH];
    GetModuleFileNameA(NULL, logPath, MAX_PATH);
    strcpy(strrchr(logPath, '\\') + 1, "hook_log.txt");
    g_logFile = fopen(logPath, "w");
        if (g_logFile) {
            fprintf(g_logFile, "=== Hook DLL Loaded ===\n");
            fprintf(g_logFile, "PID: %d\n", GetCurrentProcessId());
            fprintf(g_logFile, "Base: %p\n", hinstDLL);
            
            // Try to hook SDL2's SDL_PollEvent
            if (HookIAT("SDL2.dll", "SDL_PollEvent", (void*)HookedSDL_PollEvent, (void**)&origSDL_PollEvent)) {
                fprintf(g_logFile, "SUCCESS: Hooked SDL_PollEvent!\n");
            } else {
                fprintf(g_logFile, "FAILED: Could not hook SDL_PollEvent\n");
                fprintf(g_logFile, "SDL2.dll may not be loaded yet or function name differs\n");
            }
            
            fflush(g_logFile);
        }
    }
    else if (fdwReason == DLL_PROCESS_DETACH) {
        if (g_logFile) {
            fprintf(g_logFile, "=== Hook DLL Unloaded ===\n");
            fprintf(g_logFile, "Total frames: %d\n", g_frameCount);
            fclose(g_logFile);
        }
    }
    return TRUE;
}
