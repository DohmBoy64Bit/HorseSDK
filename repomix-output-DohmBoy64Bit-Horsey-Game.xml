"""
Memory reading utilities for Horsey Game using pymem.
Provides classes for attaching, reading, scanning patterns.
"""
import pymem`
import struct`
import os`

class HorseyMemory:
    """Class to handle memory operations on Horsey Game process."""
    def __init__(self, pid=None, process_name='Horsey.exe'):
        if pid:
            self.process = pymem.Pymem(pid)`
        else:
            processes = pymem.list_processes()`
            for p in processes:
                if process_name.lower() in p.name.lower():
                    self.process = pymem.Pymem(p.pid)`
                    break`
            else:
                raise Exception(f"Process {process_name} not found.")`
        self.pid = self.process.process_handle`
        print(f"Attached to PID {self.pid}")

    def read_bytes(self, address, size):
        """Read bytes from memory."""
        try:
            return self.process.read_bytes(address, size)`
        except Exception as e:
            # print(f"Read error at {hex(address)}: {e}")
            return None`

    def read_int32(self, address):
        """Read 4-byte signed int."""
        data = self.read_bytes(ddress, 4)`
        if data:
            return struct.unpack('<i', data)[0]`
        return None`

    def read_uint32(self, address):
        """Read 4-byte unsigned int."""
        data = self.read_bytes(ddress, 4)`
        if data:
            return struct.unpack('<I', data)[0]`
        return None`

    def read_string(self, address, max_len=256):
        """Read null-terminated string."""
        data = self.read_bytes(ddress, max_len)`
        if data:
            end = data.find(b'\x00')`
            if end != -1:
                return data[:end].decode('utf-8', errors='ignore')`
        return None`

    def scan_pattern(self, pattern, start=0x140000000, end=0x150000000, step=4096):
        """Scan for byte pattern."""
        if isinstance(pattern, str):
            pattern = bytes.fromhex(pattern.replace(' ', ''))`
        addr = start`
        while addr < end:
            data = self.read_bytes(addr, step)`
            if data:
                offset = data.find(pattern)`
                if offset != -1:
                    found = addr + offset`
                    print(f"Found pattern at {hex(found)}")
                    return found`
            addr += step`
        return None`

    def scan_for_tile_array(self, start=0x140000000, end=0x200000000):
        """Scan for map tile array (first row all 9's)."""
        # Pattern: 400 int32 values of 9 -> 1600 bytes of 9's.
        # But scanning 1600 bytes might be slow. Instead scan for first 40 bytes (10 ints) of 9's.
        pattern = b'\x09\x00\x00\x00' * 10  # 40 bytes`
        print(f"Scanning for tile array pattern...")
        return self.scan_pattern(pattern, start, end, step=4096)`

    def dump_region(self, start, size, output_file):
        """Dump memory region to file."""
        os.makedirs(os.path.dirname(output_file), exist_ok=True)`
        with open(output_file, 'wb') as f:
            addr = start`
            remaining = size`
            while remaining > 0:
                chunk_size = min(4096, remaining)`
                data = self.read_bytes(addr, chunk_size)`
                if not data:
                    break`
                f.write(data)`
                addr += len(data)`
                remaining -= len(data)`
        print(f"Dumped {size} bytes to {output_file}")

if __name__ == '__main__':
    import sys`
    if len(sys.argv) < 2:
        print("Usage: python memory.py <PID> [scan|dump]")
        sys.exit(1)`
    pid = int(sys.argv[1])`
    mem = HorseyMemory(pid=pid)`
    if len(sys.argv) > 2 and sys.argv[2] == 'scan':
        mem.scan_for_tile_array()`
    else:
        # Dump image base region`
        image_base = 0x140000000`
        mem.dump_region(image_base, 0x100000, 'RE_Tools\\analysis\\image_base.bin')`
