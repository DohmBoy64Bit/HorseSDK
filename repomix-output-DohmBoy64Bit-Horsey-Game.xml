Map size: 400x225 = 90,000 tiles. Tile IDs observed: 0-200.
Assume 4-byte integers (int32) stored row-major (y then x).
"""
import sys`
import pymem`
import struct`

def scan_for_tile_array(process, start_addr=0x140000000, end_addr=0x150000000, step=4096):
    """Scan memory for contiguous block of 4-byte ints matching map dimensions."""
    # Known tile IDs pattern: first few tiles might be all 9 (Plain?) Actually start of map has 9s.
    # But we can search for a sequence like [9,9,9,...] or known pattern from CSV.
    # Simpler: scan for region with many small ints (0-200) repeatedly.
    addr = start_addr`
    while addr < end_addr:
        try:
            data = process.read_bytes(addr, step)`
        except:
            addr += step`
            continue`
        # Check if this region looks like tile data: many small ints.
        # Unpack as int32 little-endian.
        ints = struct.unpack(f'<{step//4}i', data)`
        # Heuristic: at least 50% of values are <= 200 and >= 0.
        small = sum(1 for v in ints if 0 <= v <= 200)`
        if small >= len(ints) * 0.5:
            # Might be tile array. Check if next pages also match.
            print(f"Candidate region at {hex(addr)}: {small}/{len(ints)} small ints")
            # Read larger chunk (map size 90,000 * 4 = 360,000 bytes ~ 0x57E40)
            # For now, just note candidate.
        addr += step`
    return None`

def find_tile_pattern(process, pattern_list, start=0x140000000, end=0x150000000):
    """Search for a specific sequence of tile IDs."""
    pat_bytes = b''`
    for val in pattern_list:
        pat_bytes += struct.pack('<i', val)`
    return process.scan_bytes(pat_bytes, start, end-start)`

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: python scan_map.py <PID>")
