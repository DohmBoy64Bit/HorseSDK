"""
Flexible map scanner: tries int32 and int16, and small‑value rows.
"""
import sys, pymem, struct

def scan_for_map(process, region_start, region_end, step=0x1000):
    """Scan region for 400‑tile row (int32 or int16) with values <= 200."""
    print(f"Scanning region 0x{region_start:X} – 0x{region_end:X}...")
    addr = region_start
    while addr < region_end:
        try:
            data = process.read_bytes(addr, step)
        except:
            addr += step
            continue

        # Try int32 (4 bytes per tile)
        for width in [4]:
            tile_count = 400
            stride = width * tile_count
            for start_offset in range(0, len(data) - stride, 4):
                chunk = data[start_offset:start_offset+stride]
                vals = struct.unpack(f'<{tile_count}i', chunk)
                if all(0 <= v <= 200 for v in vals):
                    # Found a candidate row — check if next row also valid
                    try:
                        next_row = process.read_bytes(addr + start_offset + stride, stride)
                        next_vals = struct.unpack(f'<{tile_count}i', next_row)
                        if all(0 <= v <= 200 for v in next_vals):
                            found = addr + start_offset
                            print(f"Found int32 map candidate at 0x{found:X}")
                            # Read full map
                            full = process.read_bytes(found, 400*225*4)
                            ints = struct.unpack(f'<{400*225}i', full)
                            if all(0 <= v <= 200 for v in ints):
                                print(f"  Full map validated: {len(ints)} tiles")
                                with open('RE_Tools\\analysis\\map_array.bin', 'wb') as f:
                                    f.write(full)
                                print("  Saved to RE_Tools\\analysis\\map_array.bin")
                                return found
                    except:
                        pass

        # Try int16 (2 bytes per tile)
        for width in [2]:
            tile_count = 400
            stride = width * tile_count
            for start_offset in range(0, len(data) - stride, 2):
                chunk = data[start_offset:start_offset+stride]
                vals = struct.unpack(f'<{tile_count}H', chunk)
                if all(0 <= v <= 200 for v in vals):
                    found = addr + start_offset
                    print(f"Found int16 map candidate at 0x{found:X}")
                    try:
                        full = process.read_bytes(found, 400*225*2)
                        ints = struct.unpack(f'<{400*225}H', full)
                        if all(0 <= v <= 200 for v in ints):
                            print(f"  Full map validated: {len(ints)} tiles (int16)")
                            with open('RE_Tools\\analysis\\map_array_16.bin', 'wb') as f:
                                f.write(full)
                            print("  Saved to RE_Tools\\analysis\\map_array_16.bin")
                            return found
                    except:
                        pass

        addr += step

    print("Pattern not found in region.")
    return None

if __name__ == '__main__':
