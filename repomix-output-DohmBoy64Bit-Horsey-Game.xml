"""
Parser for sound.xml.
Defines sound/music events mapped to audio files with optional volume and pitch.
"""
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from typing import List, Optional
import sys
import os

# Add parent directory to sys.path so we can import core.paths
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'core'))
from paths import get_data_dir

@dataclass
class SoundEvent:
    name: str
    event_type: str  # 'music' or 'sound'
    file: Optional[str] = None  # f attribute
    volume: Optional[int] = None  # vol attribute
    pitch: Optional[int] = None  # pitch attribute
    pitch_low: Optional[int] = None  # pitchlow attribute
    pitch_high: Optional[int] = None  # pitchhigh attribute

    @staticmethod
    def from_xml(element, event_type: str) -> 'SoundEvent':
        attrs = element.attrib
        name = attrs.get('n', '')
        file = attrs.get('f', None)
        if file == '':
            file = None
        volume = int(attrs['vol']) if 'vol' in attrs else None
        pitch = int(attrs['pitch']) if 'pitch' in attrs else None
        pitch_low = int(attrs['pitchlow']) if 'pitchlow' in attrs else None
        pitch_high = int(attrs['pitchhigh']) if 'pitchhigh' in attrs else None
        return SoundEvent(name, event_type, file, volume, pitch, pitch_low, pitch_high)

@dataclass
class SoundSet:
    music_events: List[SoundEvent] = field(default_factory=list)
    sound_events: List[SoundEvent] = field(default_factory=list)

    @staticmethod
    def load(file_path: str) -> 'SoundSet':
        tree = ET.parse(file_path)
        root = tree.getroot()  # <Sounds>
        sound_set = SoundSet()
        for elem in root:
            if elem.tag == 'music':
                sound_set.music_events.append(SoundEvent.from_xml(elem, 'music'))
            elif elem.tag == 'sound':
                sound_set.sound_events.append(SoundEvent.from_xml(elem, 'sound'))
        return sound_set

    def get_event(self, name: str) -> Optional[SoundEvent]:
        for ev in self.music_events + self.sound_events:
            if ev.name == name:
                return ev
        return None

    def get_by_type(self, event_type: str) -> List[SoundEvent]:
        if event_type == 'music':
            return self.music_events
        elif event_type == 'sound':
            return self.sound_events
        return []

if __name__ == '__main__':
    data_dir = get_data_dir()
    if not os.path.isdir(data_dir):
        print(f"Data directory not found: {data_dir}")
    else:
        sound_path = os.path.join(data_dir, 'sound.xml')
        if os.path.exists(sound_path):
            sound_set = SoundSet.load(sound_path)
            print(f"Music events: {len(sound_set.music_events)}")
            print(f"Sound events: {len(sound_set.sound_events)}")
            # print first 3 music events`
            for ev in sound_set.music_events[:3]:
                print(f"  Music: {ev.name} -> {ev.file} (vol={ev.volume})")
            # print first 3 sound events`
            for ev in sound_set.sound_events[:3]:
                print(f"  Sound: {ev.name} -> {ev.file} (vol={ev.volume})")
        else:
            print(f"File not found: {sound_path}")
