"""
Utility to locate game data directory relative to this project.
"""
import os

def get_data_dir() -> str:
    """Return path to the game's data directory."""
    # This script is in RE_Tools\tools\core\ or RE_Tools\tools\parsers\
    # We'll go up until we find the 'data' directory.
    # Assume standard layout: project root contains 'data' and 'RE_Tools' folders.
    # Start from this file's location:
    current = os.path.dirname(os.path.abspath(__file__))
    # Go up until we find a directory containing 'data' folder.
    # Try up to 4 levels.
    for _ in range(5):
        candidate = os.path.join(current, 'data')
        if os.path.isdir(candidate):
            return candidate
        # Also check if current itself is game root (contains data)
        if os.path.isdir(os.path.join(current, 'data')):
            return os.path.join(current, 'data')
        parent = os.path.dirname(current)
        if parent == current:  # reached filesystem root
            break
        current = parent
    # Fallback: assume data is in same dir as this script's grandparent's sibling
    # Heuristic: if this file is in RE_Tools\tools\parsers, then game root is 3 levels up.
    current = os.path.dirname(os.path.abspath(__file__))
    for _ in range(3):
        current = os.path.dirname(current)
    candidate = os.path.join(current, 'data')
    if os.path.isdir(candidate):
        return candidate
    # Last resort: current directory
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data')
