"""
Dump horsey.tmx as text using terrain.xml and locs.xml sprite names.
"""
import sys
import os

# Add parent directory to sys.path so we can import parsers
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'parsers'))

from texture_atlas import TextureAtlas
from tiled_map import TiledMap

def dump_map(map_path, terrain_atlas, locs_atlas):
    tmap = TiledMap.load(map_path)
    if not tmap.layers:
        print("No layers found.")
        return
    layer = tmap.layers[0]  # assume first layer is Tiles
    print(f"Map size: {layer.width}x{layer.height}")
    # Determine tileset offsets
    terrain_gid_start = None
    locs_gid_start = None
    for ts in tmap.tilesets:
        if 'terrain' in ts.source.lower():
            terrain_gid_start = ts.first_gid
        elif 'locs' in ts.source.lower():
            locs_gid_start = ts.first_gid
    if terrain_gid_start is None:
        print("Terrain tileset not found.")
        return
    # Build sprite name lists
    terrain_sprites = [s.name for s in terrain_atlas.sprites]
    locs_sprites = [s.name for s in locs_atlas.sprites] if locs_atlas else []
    # Print map as grid of sprite names (truncated)
    for y in range(min(20, layer.height)):  # first 20 rows
        row = []
        for x in range(min(30, layer.width)):  # first 30 cols
            gid = layer.get_tile(x, y)
            if gid == 0:
                row.append('..')
            elif locs_gid_start is not None and gid >= locs_gid_start:
                idx = gid - locs_gid_start
                if idx < len(locs_sprites):
                    name = locs_sprites[idx]
                else:
                    name = f"L{idx}"
                row.append(name[:3])
            else:
                idx = gid - terrain_gid_start
                if idx < len(terrain_sprites):
                    name = terrain_sprites[idx]
                else:
                    name = f"T{idx}"
                row.append(name[:3])
        print(f"y={y:3d}:", ' '.join(row))

if __name__ == '__main__':
    # Find data directory
    sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'core'))
    from paths import get_data_dir
    data_dir = get_data_dir()
    if not data_dir or not os.path.isdir(data_dir):
        print(f"Data directory not found: {data_dir}")
        sys.exit(1)
    # Load atlases
    terrain_path = os.path.join(data_dir, 'terrain.xml')
    locs_path = os.path.join(data_dir, 'locs.xml')
    if not os.path.exists(terrain_path):
        print(f"terrain.xml not found at {terrain_path}")
        sys.exit(1)
    terrain_atlas = TextureAtlas.load(terrain_path)
    locs_atlas = None
    if os.path.exists(locs_path):
        locs_atlas = TextureAtlas.load(locs_path)
    else:
        print(f"locs.xml not found, location tiles will be shown as IDs.")
    # Load map
