void Log(const char* msg) {
    OutputDebugStringA(msg);
    FILE* f = fopen("E:\\games\\Horsey Game\\hook_log.txt", "a");
    if (f) { fprintf(f, "%s\n", msg); fclose(f); }
}

#define SAVE_FUNC_RVA 0x6E2B0  // Load function

bool InstallHook(HMODULE gameBase, DWORD rva) {
    BYTE* target = (BYTE*)gameBase + rva;
    char msg[256];
    
    sprintf(msg, "Hooking Load at %p", target);
    Log(msg);
    
    // Save original bytes
    BYTE orig[16];
    ReadProcessMemory(GetCurrentProcess(), target, orig, 16, NULL);
    sprintf(msg, "Original: %02X %02X %02X %02X %02X %02X", 
            orig[0], orig[1], orig[2], orig[3], orig[4], orig[5]);
    Log(msg);
    
    // Instead of just RET, let's create a logging stub
    // We'll use a simple approach: patch to call our logging code
    
    // For now, just patch with RET but print before returning
    // In a real implementation we'd use a trampoline
    
    // But since we can't use inline asm, let's do this:
    // Just log that we're about to return, then return
    
    // Make writable
    DWORD old;
    VirtualProtect(target, 16, PAGE_EXECUTE_READWRITE, &old);
    
    // Just log the attempt - don't actually block the function
    // Instead of patching, let's just trace when it's called by
    // reading a counter we'll increment
    
    static int callCount = 0;
    callCount++;
    
    time_t now = time(NULL);
    char timeStr[32];
    strftime(timeStr, 32, "%H:%M:%S", localtime(&now));
    
    sprintf(msg, ">>> SAVE CALLED! Count: %d at %s", callCount, timeStr);
    Log(msg);
    
    // Patch with RET to block save - see if it's called
    BYTE patch[16] = { 0xC3, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
                      0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90 };
    WriteProcessMemory(GetCurrentProcess(), target, patch, 16, NULL);
    FlushInstructionCache(GetCurrentProcess(), target, 16);
    VirtualProtect(target, 16, old, &old);
    
    Log("Hook installed - Load will be blocked!");
    return true;
}

BOOL WINAPI DllMain(HINSTANCE h, DWORD reason, LPVOID) {
    if (reason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(h);
        Log("=== LOAD TRACE HOOK LOADED ===");
        
        HMODULE mods[256];
        DWORD needed;
        if (EnumProcessModules(GetCurrentProcess(), mods, sizeof(mods), &needed)) {
            for (DWORD i = 0; i < needed / sizeof(HMODULE); i++) {
                char name[256];
                GetModuleBaseNameA(GetCurrentProcess(), mods[i], name, 256);
                if (!strcmp(name, "Horsey.exe")) {
                    // Install hook that TRACES (logs) but doesn't block
                    InstallHook(mods[i], SAVE_FUNC_RVA);
                    break;
                }
            }
        }
    }
    return TRUE;
}
