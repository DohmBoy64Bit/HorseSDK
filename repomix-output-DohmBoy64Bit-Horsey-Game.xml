"""
Horsey Trace - Python-based function tracer
Uses pymem to attach to Horsey and trace function calls
"""

import ctypes
import pymem
import pymem.process
import sys
import os
from typing import Optional

class HorseyTracer:
    def __init__(self):
        self.pm: Optional[pymem.Pymem] = None
        self.base_addr = None
        
    def attach(self, process_name: str = "Horsey.exe") -> bool:
        """Attach to Horsey process"""
        try:
            self.pm = pymem.Pymem(process_name)
            # Get module base
            modules = list(pymem.process.module_iter(self.pm.process_handle))
            for mod in modules:
                if mod.name.lower() == process_name.lower():
                    self.base_addr = mod.lpBaseOfDll
                    print(f"Attached to {process_name}")
                    print(f"Base address: {hex(self.base_addr)}")
                    return True
            print(f"Could not find {process_name} module")
            return False
        except Exception as e:
            print(f"Failed to attach: {e}")
            return False
    
    def find_string(self, text: str) -> list:
        """Find all occurrences of a string in memory"""
        if not self.pm:
            return []
        
        addresses = []
        
        # Search through allocated memory
        try:
            # Use pymem's pattern scanning
            for page in pymem.memory.range_by_tool(self.pm.process_handle, 0, 0x7FFFFFFF):
                if page.state != 0x10000:  # MEM_COMMIT
                    continue
                if not (page.protect & 0x4):  # PAGE_READABLE
                    continue
                    
                try:
                    data = self.pm.read_bytes(page.base_address, page.size)
                    pos = 0
                    while True:
                        pos = data.find(text.encode(), pos)
                        if pos == -1:
                            break
                        addr = page.base_address + pos
                        addresses.append(addr)
                        pos += 1
                except:
                    pass
        except Exception as e:
            print(f"Search error: {e}")
            
        return addresses
    
    def hook_createfile(self):
        """Hook CreateFileA to trace file operations"""
        if not self.pm:
            return
            
        kernel32 = ctypes.windll.kernel32
        
        # Get original function
        orig = kernel32.CreateFileA
        
        # Create a wrapper that logs
        def hooked_CreateFileA(filename, access, share, sec, create, flags, template):
            try:
                name = ctypes.string_at(filename).decode('utf-8', errors='ignore')
                print(f"CreateFileA: {name}")
                
                # Check for game files
                if any(x in name.lower() for x in ['.tmx', '.xml', 'save', 'horsey']):
                    print(f"  ==> GAME FILE!")
                    
                # Write to log
                with open("horsey_trace_log.txt", "a") as f:
                    f.write(f"CreateFileA: {name}\n")
                    
            except Exception as e:
                print(f"Hook error: {e}")
                
            return orig(filename, access, share, sec, create, flags, template)
        
        # This won't actually work - can't hook like this
        # Would needdetours or similar
        print("Note: Cannot hook with pure Python")
        print("Use x64dbg or Frida for actual hooking")
        
    def dump_modules(self):
        """Dump all loaded modules"""
        if not self.pm:
            return
            
        print("\n=== Loaded Modules ===")
        for mod in pymem.process.module_iter(self.pm.process_handle):
            print(f"  {mod.name}: {hex(mod.lpBaseOfDll)} - {mod.size_of_image} bytes")

def main():
    tracer = HorseyTracer()
    
    if not tracer.attach():
        print("Failed to attach - is Horsey running?")
        return
    
    # Dump modules
    tracer.dump_modules()
    
    # Search for "horsey.tmx" in memory
    print("\n=== Searching for 'horsey.tmx' ===")
    addrs = tracer.find_string("horsey.tmx")
    print(f"Found {len(addrs)} occurrences:")
    for addr in addrs:
        print(f"  {hex(addr)}")
    
    # Search for ".tmx"
    print("\n=== Searching for '.tmx' ===")
    addrs = tracer.find_string(".tmx")
    print(f"Found {len(addrs)} occurrences")
    
    # Search for "save"
    print("\n=== Searching for 'save' ===")
    addrs = tracer.find_string("save")
    print(f"Found {len(addrs)} occurrences")

if __name__ == "__main__":
    main()
