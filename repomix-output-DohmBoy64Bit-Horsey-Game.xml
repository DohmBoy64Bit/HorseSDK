import os
import sys

def compare_saves(file1, file2, name1="before", name2="after"):
    """Compare two save files and show what changed"""
    
    if not os.path.exists(file1):
        print(f"Error: {file1} not found")
        return
    
    if not os.path.exists(file2):
        print(f"Error: {file2} not found")
        return
    
    data1 = open(file1, "rb").read()
    data2 = open(file2, "rb").read()
    
    print(f"{name1}: {len(data1)} bytes")
    print(f"{name2}: {len(data2)} bytes")
    print()
    
    if len(data1) != len(data2):
        print(f"SIZE CHANGE: {len(data1)} -> {len(data2)} bytes")
        print()
    
    print("=== CHANGES ===")
    changes = []
    for i, (a, b) in enumerate(zip(data1, data2)):
        if a != b:
            changes.append((i, a, b))
    
    if not changes:
        print("No byte-level changes (strings might differ)")
        # Check for string changes
        for i in range(min(len(data1), len(data2))):
            if data1[i] != data2[i]:
                if i > 100:  # Skip header differences
                    print(f"  String at offset {i}: {repr(data1[i:i+20])} -> {repr(data2[i:i+20])}")
        return
    
    # Group consecutive changes
    last_offset = None
    for offset, old_val, new_val in changes[:50]:  # Show first 50
        if last_offset is None or offset > last_offset + 10:
            print(f"\n  Offset {offset} (0x{offset:X}):")
        print(f"    {offset}: {old_val:02X} -> {new_val:02X}")
        last_offset = offset
    
    print(f"\n  Total changed bytes: {len(changes)}")
    
    # Show context around each change
    print("\n=== CHANGE DETAILS ===")
    for offset, old_val, new_val in changes[:20]:
        # Get some context
        start = max(0, offset - 10)
        end = min(len(data2), offset + 10)
        
        print(f"\nOffset {offset} (0x{offset:X}):")
        print(f"  Before: {data1[start:end].hex()}")
        print(f"  After:  {data2[start:end].hex()}")
        
        # Interpret as int if aligned
        if offset % 4 == 0 and offset + 4 <= len(data2):
            old_int = int.from_bytes(data1[offset:offset+4], 'little')
            new_int = int.from_bytes(data2[offset:offset+4], 'little')
            print(f"  As int: {old_int} -> {new_int}")

if __name__ == "__main__":
    # Default: compare save1.dat and a backup
    save_file = "save/save1.dat"
    backup_file = "save/save1_backup.dat"
    
    if len(sys.argv) > 2:
        compare_saves(sys.argv[1], sys.argv[2])
    elif len(sys.argv) > 1:
        compare_saves(sys.argv[1], save_file)
    else:
        # Check if backup exists
        if os.path.exists(backup_file):
            compare_saves(backup_file, save_file, "backup", "current")
        else:
            print("Usage: python compare_saves.py <file1> <file2>")
            print(f"Or: copy current save to save/save1_backup.dat, make a change, then run")
