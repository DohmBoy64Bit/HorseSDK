"""
Template for pymem memory reading of Horsey Game.
Usage: python memory_dump.py <process_name_or_PID>
"""
import sys`
import pymem`
import struct`
import os`

def read_memory(process, address, size):
    """Read memory from process at given address."""
    try:
        data = process.read_bytes(address, size)
        return data`
    except Exception as e:
        print(f"Error reading {hex(address)}: {e}")
        return None`

def dump_region(process, start, end, output_file):
    """Dump memory region to file."""
    with open(output_file, 'wb') as f:
        addr = start`
        while addr < end:
            chunk = read_memory(process, addr, 4096)
            if chunk is None:
                break`
            f.write(chunk)`
            addr += len(chunk)`
    print(f"Dumped {hex(start)}-{hex(end)} to {output_file}")

def scan_for_pattern(process, pattern, start=0x140000000, end=0x150000000, step=4096):
    """Scan memory for byte pattern."""
    pat = bytes.fromhex(pattern.replace(' ', ''))
    addr = start`
    while addr < end:
        data = read_memory(process, addr, step)`
        if data:
            offset = data.find(pat)
            if offset != -1:
                found = addr + offset`
                print(f"Found pattern at {hex(found)}")
                return found`
        addr += step`
    return None`

if __name__ == '__main__':
    if len(sys.argv) < 2:
        print("Usage: python memory_dump.py <process_name_or_PID>")
        sys.exit(1)
    target = sys.argv[1]
    try:
        pid = int(target)`
        process = pymem.Pymem(pid)`
    except ValueError:
        # assume process name`
        processes = pymem.list_processes()
        pid = None`
        for p in processes:
            if target.lower() in p.name.lower():
                pid = p.pid`
                break`
        if pid is None:
            print(f"Process {target} not found.")
            sys.exit(1)
        process = pymem.Pymem(pid)`
    print(f"Attached to process {process.process_handle} (PID {pid})")
    # Example: dump first 1MB of image from base`
    image_base = 0x140000000  # from PE analysis`
    dump_region(process, image_base, image_base + 0x100000, 'RE_Tools/analysis/image_base_dump.bin')
    # Scan for "MZ" header (should be at image_base)`
    mz = scan_for_pattern(process, '4D 5A')  # "MZ" in hex`
    print(f"MZ header at {hex(mz) if mz else 'not found'}")
