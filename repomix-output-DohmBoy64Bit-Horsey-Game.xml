"""
Parser for TextureAtlas XML files (terrain.xml, locs.xml, veg.xml, sprites.xml, furniture.xml).
Each defines sprites with attributes: n (name), x, y, w, h, and optional c (frame count), hx, hy (hotspot).
"""
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from typing import List, Optional
import sys
import os

# Add parent directory to sys.path so we can import core.paths
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'core'))
from paths import get_data_dir

@dataclass
class Sprite:
    name: str
    x: int
    y: int
    width: int
    height: int
    frame_count: Optional[int] = None
    hotspot_x: Optional[float] = None
    hotspot_y: Optional[float] = None

    @staticmethod
    def from_xml(element) -> 'Sprite':
        attrs = element.attrib
        name = attrs.get('n', '')
        x = int(attrs.get('x', '0'))
        y = int(attrs.get('y', '0'))
        w = int(attrs.get('w', '0'))
        h = int(attrs.get('h', '0'))
        c = int(attrs['c']) if 'c' in attrs else None
        hx = float(attrs['hx']) if 'hx' in attrs else None
        hy = float(attrs['hy']) if 'hy' in attrs else None
        return Sprite(name, x, y, w, h, c, hx, hy)

@dataclass
class TextureAtlas:
    sprites: List[Sprite] = field(default_factory=list)
    source_file: str = ''

    @staticmethod
    def load(file_path: str) -> 'TextureAtlas':
        tree = ET.parse(file_path)
        root = tree.getroot()
        if root.tag != 'TextureAtlas':
            raise ValueError(f"Expected TextureAtlas root, got {root.tag}")
        atlas = TextureAtlas(source_file=file_path)
        for sprite_elem in root.findall('sprite'):
            atlas.sprites.append(Sprite.from_xml(sprite_elem))
        return atlas

    def get_sprite(self, name: str) -> Optional[Sprite]:
        for sprite in self.sprites:
            if sprite.name == name:
                return sprite
        return None

    def to_dict(self) -> dict:
        return {
            'source_file': self.source_file,
            'sprites': [sprite.__dict__ for sprite in self.sprites]
        }

if __name__ == '__main__':
    data_dir = get_data_dir()
    if not os.path.isdir(data_dir):
        print(f"Data directory not found: {data_dir}")
    else:
        for xml_file in ['terrain.xml', 'locs.xml', 'veg.xml', 'sprites.xml', 'furniture.xml']:
            path = os.path.join(data_dir, xml_file)
