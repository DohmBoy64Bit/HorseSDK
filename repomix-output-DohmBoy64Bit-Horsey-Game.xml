"""
Search for Horsey map tile array in memory using pymem.
Usage: python scan_tiles.py <PID>
Map: 400x225 tiles, each tile ID is 4-byte int (little-endian).
First row from dump: all 9's (maybe). Use pattern of consecutive 9's.
"""
import sys
import pymem
import struct

def find_tile_array(process, pid):
    """Search for tile array by scanning memory regions."""
    # Typical map data might be allocated on heap or in .data section.
    # Let's scan from image base to 0x200000000.
    start = 0x140000000  # image base
    end = 0x200000000
    step = 0x1000
    # Pattern: first 8 tiles are 9 (0x00000009) -> 32 bytes of 9's.
    pattern = b'\x09\x00\x00\x00' * 8  # 32 bytes
    print(f"Scanning from {hex(start)} to {hex(end)}...")
    addr = start
    while addr < end:
        try:
            data = process.read_bytes(addr, step)
        except:
            addr += step
            continue
        offset = data.find(pattern)
        if offset != -1:
            found = addr + offset
            print(f"Found candidate at {hex(found)}")
            # Validate: read larger chunk and check if it looks like tile data.
            chunk_size = 400 * 4  # first row (400 tiles)
            try:
                row = process.read_bytes(found, chunk_size)
                ints = struct.unpack(f'<{400}i', row)
                # Check if all values are <= 200 (valid tile IDs)
                if all(0 <= v <= 200 for v in ints):
                    print(f"  First row validated: {ints[:10]}...")
                    # Maybe this is the map data.
                    return found
            except:
                pass
        addr += step
    print("Pattern not found.")
    return None

if __name__ == '__main__':
    if len(sys.argv) < 2:
