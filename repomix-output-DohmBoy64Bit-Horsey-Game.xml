"""
Parser for horsey.tmx (Tiled TMX map) and related tilesets.
Handles orthogonal maps with CSV tile data.
"""
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from typing import List, Optional, Dict
import csv
import io
import os
import sys

@dataclass
class Tileset:
    first_gid: int
    source: str  # .tsx file path (relative)
    name: str = ''
    tile_width: int = 0
    tile_height: int = 0
    image_source: str = ''
    image_width: int = 0
    image_height: int = 0

@dataclass
class Layer:
    id: int
    name: str
    width: int
    height: int
    data: List[List[int]] = field(default_factory=list)  # 2D grid row-major: data[y][x]
    encoding: str = 'csv'
    data_format: str = 'csv'  # or 'base64', 'zlib', etc.

    def get_tile(self, x: int, y: int) -> int:
        if 0 <= y < len(self.data) and 0 <= x < len(self.data[y]):
            return self.data[y][x]
        return 0

    def to_flat_list(self) -> List[int]:
        flat = []
        for row in self.data:
            flat.extend(row)
        return flat

@dataclass
class TiledMap:
    version: str
    tiled_version: str
    orientation: str
    render_order: str
    width: int
    height: int
    tile_width: int
    tile_height: int
    infinite: bool
    next_layer_id: int
    next_object_id: int
    tilesets: List[Tileset] = field(default_factory=list)
    layers: List[Layer] = field(default_factory=list)

    @staticmethod
    def load(file_path: str) -> 'TiledMap':
        tree = ET.parse(file_path)
        root = tree.getroot()  # <map>
        tmap = TiledMap(
            version=root.get('version', ''),
            tiled_version=root.get('tiledversion', ''),
            orientation=root.get('orientation', ''),
            render_order=root.get('renderorder', ''),
            width=int(root.get('width', '0')),
            height=int(root.get('height', '0')),
            tile_width=int(root.get('tilewidth', '0')),
            tile_height=int(root.get('tileheight', '0')),
            infinite=root.get('infinite', '0') == '1',
            next_layer_id=int(root.get('nextlayerid', '0')),
            next_object_id=int(root.get('nextobjectid', '0'))
        )
        # Parse tilesets
        for ts_elem in root.findall('tileset'):
            ts = Tileset(
                first_gid=int(ts_elem.get('firstgid', '0')),
                source=ts_elem.get('source', ''),
                name=ts_elem.get('name', ''),
                tile_width=int(ts_elem.get('tilewidth', '0')),
                tile_height=int(ts_elem.get('tileheight', '0'))
            )
            # If there's an image child, parse it
            image_elem = ts_elem.find('image')
            if image_elem is not None:
                ts.image_source = image_elem.get('source', '')
                ts.image_width = int(image_elem.get('width', '0'))
                ts.image_height = int(image_elem.get('height', '0'))
            tmap.tilesets.append(ts)
        # Parse layers
        for layer_elem in root.findall('layer'):
            layer = Layer(
                id=int(layer_elem.get('id', '0')),
                name=layer_elem.get('name', ''),
                width=int(layer_elem.get('width', '0')),
                height=int(layer_elem.get('height', '0')))
            data_elem = layer_elem.find('data')
            if data_elem is not None:
                layer.encoding = data_elem.get('encoding', 'csv')
                layer.data_format = data_elem.get('format', 'csv')
                if layer.encoding == 'csv':
                    csv_text = data_elem.text.strip() if data_elem.text else ''
                    # Replace newlines with commas, then split by commas
                    # The CSV data may have newlines, but treat as continuous comma-separated values.
                    csv_text = csv_text.replace('\n', ',').replace('\r', '')
                    parts = [p.strip() for p in csv_text.split(',') if p.strip()]
                    flat = []
                    for p in parts:
                        try:
                            flat.append(int(p))
                        except ValueError:
                            pass
                    # Reshape to 2D grid: rows = height, cols = width
                    # Expect flat length = width * height
                    if len(flat) == layer.width * layer.height:
                        layer.data = []
                        for y in range(layer.height):
                            start = y * layer.width
                            end = start + layer.width
                            layer.data.append(flat[start:end])
                    else:
                        # If mismatch, maybe data is not as expected; store flat list
                        layer.data = []
                        # We'll store as one row for now
                        layer.data.append(flat)
                else:
                    # TODO: handle base64, zlib
                    pass
            tmap.layers.append(layer)
        return tmap

    def get_layer(self, name: str) -> Optional[Layer]:
        for layer in self.layers:
            if layer.name == name:
                return layer
        return None

    def get_tileset_for_gid(self, gid: int) -> Optional[Tileset]:
        """Return the tileset that contains the given global tile ID."""
        for ts in sorted(self.tilesets, key=lambda t: t.first_gid, reverse=True):
            if gid >= ts.first_gid:
                return ts
        return None

    def local_id(self, gid: int, tileset: Tileset) -> int:
        """Convert global tile ID to local tile ID within tileset."""
        return gid - tileset.first_gid

if __name__ == '__main__':
    import sys
    sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'core'))
    from paths import get_data_dir
    data_dir = get_data_dir()
    if not os.path.isdir(data_dir):
        print(f"Data directory not found: {data_dir}")
    else:
        map_path = os.path.join(data_dir, 'horsey.tmx')
        if os.path.exists(map_path):
            tmap = TiledMap.load(map_path)
            print(f"Map: {tmap.width}x{tmap.height}, tile size {tmap.tile_width}x{tmap.tile_height}")
            print(f"Tilesets: {len(tmap.tilesets)}")
            for ts in tmap.tilesets:
                print(f"  Tileset: firstgid={ts.first_gid}, source={ts.source}")
            print(f"Layers: {len(tmap.layers)}")
            for layer in tmap.layers:
                print(f"  Layer: {layer.name}, size {layer.width}x{layer.height}")
                if layer.data:
                    flat = layer.to_flat_list()
                    unique = set(flat)
                    print(f"    Unique tile IDs: {sorted(unique)[:20]} ...")  # first 20
        else:
            print(f"File not found: {map_path}")
