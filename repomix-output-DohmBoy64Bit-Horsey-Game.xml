# Python DLL Injector for Horsey
# No C++ needed - uses ctypes to inject

import ctypes
import os
import sys

def find_horsey_process():
    """Find Horsey.exe process"""
    import psutil
    
    for proc in psutil.process_iter(['pid', 'name']):
        try:
            if proc.info['name'].lower() == 'horsey.exe':
                return proc.info['pid']
        except:
            pass
    return None

def inject_dll(pid, dll_path):
    """Inject DLL into process"""
    
    if not os.path.exists(dll_path):
        print(f"Error: DLL not found: {dll_path}")
        return False
    
    # Get process handle
    PROCESS_ALL_ACCESS = 0x1F0FFF
    kernel32 = ctypes.windll.kernel32
    
    hProcess = kernel32.OpenProcess(PROCESS_ALL_ACCESS, False, pid)
    if not hProcess:
        print(f"Error: Could not open process: {ctypes.get_last_error()}")
        return False
    
    # Allocate memory for DLL path
    path_len = len(dll_path) + 1
    remote_path = kernel32.VirtualAllocEx(hProcess, None, path_len, 0x1000, 0x4)  # MEM_COMMIT, PAGE_READWRITE
    
    if not remote_path:
        print(f"Error: Could not allocate memory: {ctypes.get_last_error()}")
        kernel32.CloseHandle(hProcess)
        return False
    
    # Write DLL path
    written = ctypes.c_size_t()
    kernel32.WriteProcessMemory(hProcess, remote_path, dll_path.encode('utf-8'), path_len, ctypes.byref(written))
    
    # Get LoadLibraryA address
    load_lib = kernel32.LoadLibraryA
    
    # Create remote thread
    thread_id = ctypes.c_ulong()
    hThread = kernel32.CreateRemoteThread(hProcess, None, 0, load_lib, remote_path, 0, ctypes.byref(thread_id))
    
    if not hThread:
        print(f"Error: Could not create remote thread: {ctypes.get_last_error()}")
        kernel32.VirtualFreeEx(hProcess, remote_path, 0, 0x8000)
        kernel32.CloseHandle(hProcess)
        return False
    
    # Wait for thread to finish
    kernel32.WaitForSingleObject(hThread, 0xFFFFFFFF)
    
    print(f"DLL injected successfully!")
    print(f"Check hook_log.txt for output")
    
    # Cleanup
    kernel32.CloseHandle(hThread)
    kernel32.VirtualFreeEx(hProcess, remote_path, 0, 0x8000)
    kernel32.CloseHandle(hProcess)
    
    return True

def main():
    # Try to find DLL in various locations
    dll_paths = [
        "hook.dll",
        "RE_Tools\\sdk\\hook_dll\\hook.dll",
        "E:\\games\\Horsey Game\\RE_Tools\\sdk\\hook_dll\\hook.dll",
    ]
    
    # Try psutil first
    try:
        import psutil
    except ImportError:
        print("psutil not installed. Installing...")
        os.system("pip install psutil")
        import psutil
    
    # Find process
    print("Searching for Horsey.exe...")
    pid = find_horsey_process()
    
    if not pid:
        print("Horsey.exe not found. Make sure the game is running.")
        return
    
    print(f"Found Horsey.exe (PID: {pid})")
    
    # Find DLL
    dll_path = None
    for path in dll_paths:
        if os.path.exists(path):
            dll_path = path
            break
    
    if not dll_path:
        print("hook.dll not found. Please compile the hook DLL first.")
        return
    
    # Inject
    print(f"Injecting {dll_path}...")
    if inject_dll(pid, dll_path):
        print("Done!")
    else:
        print("Injection failed!")

if __name__ == "__main__":
    main()
