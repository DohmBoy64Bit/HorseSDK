// Launcher that injects DLL then starts game
#include <windows.h>
#include <stdio.h>
#include <tlhelp32.h>

// Find process by name
DWORD FindProcess(const char* name) {
    HANDLE snapshot = CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0);
    PROCESSENTRY32W pe;
    pe.dwSize = sizeof(PROCESSENTRY32W);
    
    DWORD pid = 0;
    if (Process32FirstW(snapshot, &pe)) {
        do {
            if (wcsicmp(pe.szExeFile, L"Horsey.exe") == 0) {
                pid = pe.th32ProcessID;
                break;
            }
        } while (Process32NextW(snapshot, &pe));
    }
    CloseHandle(snapshot);
    return pid;
}

// Inject DLL into running process
bool Inject(DWORD pid, const char* dllPath) {
    HANDLE hProcess = OpenProcess(PROCESS_ALL_ACCESS, FALSE, pid);
    if (!hProcess) return false;
    
    LPVOID remotePath = VirtualAllocEx(hProcess, NULL, 256, MEM_COMMIT, PAGE_READWRITE);
    WriteProcessMemory(hProcess, remotePath, dllPath, 256, NULL);
    
    HANDLE hThread = CreateRemoteThread(hProcess, NULL, 0, 
        (LPTHREAD_START_ROUTINE)GetProcAddress(GetModuleHandle("kernel32.dll"), "LoadLibraryA"),
        remotePath, 0, NULL);
    
    if (hThread) {
        WaitForSingleObject(hThread, 5000);
        CloseHandle(hThread);
    }
    
    VirtualFreeEx(hProcess, remotePath, 0, MEM_RELEASE);
    CloseHandle(hProcess);
    return true;
}

int main(int argc, char* argv[]) {
    const char* gamePath = "E:\\games\\Horsey Game\\Horsey.exe";
    const char* dllPath = "E:\\games\\Horsey Game\\RE_Tools\\sdk\\hook_dll\\mainhook.dll";
    
    printf("=== Horsey Launcher + Injector ===\n");
    
    // Kill existing instance
    system("taskkill /F /IM Horsey.exe 2>nul");
    Sleep(1000);
    
    // Start game normally (through shell, preserves original startup)
    printf("Starting game (normal startup)...\n");
    HINSTANCE result = ShellExecuteA(NULL, "open", gamePath, NULL, NULL, SW_SHOWNORMAL);
    printf("ShellExecute result: %p\n", result);
    
    if (result <= (HINSTANCE)32) {
        printf("Failed to launch! Error code: %d\n", (int)(INT_PTR)result);
        return 1;
    }
    
    // Wait for game to initialize - check multiple times
    printf("Waiting for game to load...\n");
    DWORD pid = 0;
    for (int i = 0; i < 10; i++) {
        Sleep(1000);
        pid = FindProcess("Horsey.exe");
        if (pid) {
            printf("Found game (PID: %d) after %d seconds\n", pid, i+1);
            break;
        }
        printf("Waiting... (%d/10)\n", i+1);
