// Hook DLL - Simple RET hook (won't crash, just log)
#include <windows.h>
#include <stdio.h>
#include <psapi.h>

void Log(const char* msg) {
    OutputDebugStringA(msg);
    FILE* f = fopen("E:\\games\\Horsey Game\\hook_log.txt", "a");
    if (f) { fprintf(f, "%s\n", msg); fclose(f); }
}

#define MAIN_FUNC_RVA 0x21ED0C

bool InstallHook(HMODULE gameBase, DWORD rva) {
    BYTE* target = (BYTE*)gameBase + rva;
    
    char msg[256];
    sprintf(msg, "Hooking Main at %p", target);
    Log(msg);
    
    // Save original
    BYTE orig[16];
    ReadProcessMemory(GetCurrentProcess(), target, orig, 16, NULL);
    sprintf(msg, "Original bytes: %02X %02X %02X %02X %02X %02X", 
            orig[0], orig[1], orig[2], orig[3], orig[4], orig[5]);
    Log(msg);
    
    // Make writable and patch with RET
    DWORD old;
    VirtualProtect(target, 16, PAGE_EXECUTE_READWRITE, &old);
    
    // C3 = RET instruction
    BYTE patch[16] = { 0xC3, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90,
                       0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90, 0x90 };
    WriteProcessMemory(GetCurrentProcess(), target, patch, 16, NULL);
    FlushInstructionCache(GetCurrentProcess(), target, 16);
    VirtualProtect(target, 16, old, &old);
    
    Log("Hook installed - Main returns immediately!");
    return true;
}

BOOL WINAPI DllMain(HINSTANCE h, DWORD reason, LPVOID) {
    if (reason == DLL_PROCESS_ATTACH) {
        DisableThreadLibraryCalls(h);
        Log("=== HOOK LOADED ===");
        
        HMODULE mods[256];
        DWORD needed;
        if (EnumProcessModules(GetCurrentProcess(), mods, sizeof(mods), &needed)) {
            for (DWORD i = 0; i < needed / sizeof(HMODULE); i++) {
                char name[256];
                GetModuleBaseNameA(GetCurrentProcess(), mods[i], name, 256);
                if (!strcmp(name, "Horsey.exe")) {
                    InstallHook(mods[i], MAIN_FUNC_RVA);
                    break;
                }
            }
        }
    }
    return TRUE;
}
