"""
Save file logger - hooks save function and logs writes to JSON.
Uses pymem to attach to running Horsey.exe and intercept save operations.
"""
import pymem
import struct
import json
import sys
import time
from ctypes import cast, POINTER, c_char, c_int, c_longlong

class SaveLogger:
    def __init__(self):
        self.pm = None
        self.base_addr = None
        self.writes = []
        self.current_offset = 0
        self.save_active = False
        self.log_file = None

        # RVA addresses from RE
        self.RVA_SAVE_FUNC = 0x6DAB0
        self.RVA_WRITE_INT = 0x6FE10
        self.RVA_WRITE_BYTE = 0x6FEF0
        self.RVA_WRITE_LONG = 0x6FED0
        self.RVA_WRITE_OBJ = 0x6D440

    def attach(self, process_name="Horsey.exe"):
        """Attach to the game process."""
        try:
            self.pm = pymem.Pymem(process_name)
            self.base_addr = self.pm.base_address
            print(f"Attached to {process_name}")
            print(f"Base address: 0x{self.base_addr:X}")
            print(f"Save function at: 0x{self.base_addr + self.RVA_SAVE_FUNC:X}")
            return True
        except Exception as e:
            print(f"Failed to attach: {e}")
            return False

    def start_save(self):
        """Called when save starts."""
        self.writes = []
        self.current_offset = 0
        self.save_active = True

        # Also open file for streaming
        self.log_file = open("save_log.json", "w")
        self.log_file.write('{\n  "writes": [\n')

        print("\n=== SAVE STARTED ===")

    def log_int(self, value):
        """Log an integer write."""
        if not self.save_active:
            return

        self.writes.append({
            "type": "int",
            "offset": self.current_offset,
            "value": value
        })
        print(f"  [INT] offset={self.current_offset}, value={value}")
        self.current_offset += 4

        if self.log_file and len(self.writes) <= 100:
            self.log_file.write(f'    {{"type": "int", "offset": {self.current_offset-4}, "value": {value}}},\n')

    def log_byte(self, value):
        """Log a byte write."""
        if not self.save_active:
            return

        self.writes.append({
            "type": "byte",
            "offset": self.current_offset,
            "value": value
        })
        print(f"  [BYTE] offset={self.current_offset}, value={value}")
        self.current_offset += 1

    def log_long(self, value):
        """Log a long long write."""
        if not self.save_active:
            return

        self.writes.append({
            "type": "long",
            "offset": self.current_offset,
            "value": value
        })
        print(f"  [LONG] offset={self.current_offset}, value={value}")
        self.current_offset += 8

    def end_save(self):
        """Called when save completes."""
        self.save_active = False
        print(f"=== SAVE COMPLETE: {len(self.writes)} writes ===\n")

        if self.log_file:
            # Close JSON properly
            self.log_file.write('  ]\n')
            self.log_file.write('}\n')
            self.log_file.close()

        # Also save full log
        with open("save_log_full.json", "w") as f:
            json.dump({"writes": self.writes}, f, indent=2)

    def monitor(self):
        """
        Simple monitoring approach - watch for save file changes.
        This is a fallback since hooking requires more complex setup.
        """
        import os

        save_dir = "save"
        last_size = {}

        print("Monitoring save directory for changes...")
        print("Trigger a save in-game to capture data.")

        while True:
            if not os.path.exists(save_dir):
                print(f"Save directory not found: {save_dir}")
                break

            for save_file in ["save1.dat", "save2.dat", "save3.dat"]:
                path = os.path.join(save_dir, save_file)
                if os.path.exists(path):
                    size = os.path.getsize(path)
                    if save_file in last_size and size != last_size[save_file]:
                        print(f"\n>>> {save_file} changed! Size: {size} bytes")

                        # Read first few bytes to see what's being written
                        with open(path, "rb") as f:
                            data = f.read(min(256, size))
                            print(f"First 64 bytes hex:")
                            print(" ".join(f"{b:02x}" for b in data[:64]))

                        self.start_save()

                        # Parse as much as we can
                        self.parse_save_file(path)

                        self.end_save()

                    last_size[save_file] = size

            time.sleep(0.5)

    def parse_save_file(self, path):
        """Try to parse the save file format."""
        with open(path, "rb") as f:
            data = f.read()

        print(f"Save file size: {len(data)} bytes")

        # Try to identify some common patterns
        offset = 0
        while offset < min(len(data), 1000):
            # Look for ints
            if offset + 4 <= len(data):
                val = struct.unpack('<I', data[offset:offset+4])[0]
                if 0 < val < 10000:  # Reasonable value
                    self.log_int(val)

            offset += 4

        # Known offsets from save function:
        # 0x254, 0x314, 0x268, 0x318, 0x308, 0x440, 0x37c, 0x410, 0x418, 0x41c
        # These are relative offsets in game state that get written

def main():
    logger = SaveLogger()

    if not logger.attach():
        print("Could not attach to Horsey.exe")
        print("Make sure the game is running!")
        sys.exit(1)

    # Use memory monitoring approach
    logger.monitor()

if __name__ == "__main__":
    main()
