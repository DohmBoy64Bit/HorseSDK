"""
Parser for genes.xml and pop.xml.
genes.xml defines gene parameters.
pop.xml defines population variants with gene overrides.
"""
import xml.etree.ElementTree as ET
from dataclasses import dataclass, field
from typing import List, Optional, Dict
import sys
import os

# Add parent directory to sys.path so we can import core.paths
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'core'))
from paths import get_data_dir

@dataclass
class GeneDefinition:
    name: str
    mutation_rate: int  # m attribute
    scale: int        # s attribute
    values: Dict[str, int]  # g0, g1, g2, g3
    nucleotide: str         # n attribute (4-letter string)

    @staticmethod
    def from_xml(element) -> 'GeneDefinition':
        attrs = element.attrib
        name = attrs.get('name', '')
        m = int(attrs.get('m', '0'))
        s = int(attrs.get('s', '0'))
        values = {}
        for key in ['g0', 'g1', 'g2', 'g3']:
            if key in attrs:
                values[key] = int(attrs[key])
        nucleotide = attrs.get('n', '')
        return GeneDefinition(name, m, s, values, nucleotide)

@dataclass
class GeneSet:
    """Collection of gene definitions from genes.xml."""
    genes: List[GeneDefinition] = field(default_factory=list)

    @staticmethod
    def load(file_path: str) -> 'GeneSet':
        tree = ET.parse(file_path)
        root = tree.getroot()
        # root tag is <exp>
        gene_set = GeneSet()
        for gene_elem in root.findall('gene'):
            gene_set.genes.append(GeneDefinition.from_xml(gene_elem))
        return gene_set

    def get_gene(self, name: str) -> Optional[GeneDefinition]:
        for g in self.genes:
            if g.name == name:
                return g
        return None

@dataclass
class GeneOverride:
    name: str
    values: Dict[str, int]  # p0, p1, p2, p3

    @staticmethod
    def from_xml(element) -> 'GeneOverride':
        attrs = element.attrib
        name = attrs.get('name', '')
        values = {}
        for key in ['p0', 'p1', 'p2', 'p3']:
            if key in attrs:
                values[key] = int(attrs[key])
        return GeneOverride(name, values)

@dataclass
class PopulationVariant:
    name: str
    overrides: List[GeneOverride] = field(default_factory=list)

    @staticmethod
    def from_xml(element) -> 'PopulationVariant':
        name = element.attrib.get('name', '')
        variant = PopulationVariant(name)
        for gene_elem in element.findall('gene'):
            variant.overrides.append(GeneOverride.from_xml(gene_elem))
        return variant

@dataclass
class PopulationSet:
    """Collection of population variants from pop.xml."""
    variants: List[PopulationVariant] = field(default_factory=list)

    @staticmethod
    def load(file_path: str) -> 'PopulationSet':
        tree = ET.parse(file_path)
        root = tree.getroot()  # <pops>
        pop_set = PopulationSet()
        # The root has one child <pop name="default"> which contains gene overrides and nested <pop> variants.
        top_pop = root.find('pop')  # default variant
        if top_pop is not None:
            # Add default variant
            pop_set.variants.append(PopulationVariant.from_xml(top_pop))
            # Add nested pop variants (scratch, fest horse, etc.)
            for child in top_pop:
                if child.tag == 'pop':
                    pop_set.variants.append(PopulationVariant.from_xml(child))
        return pop_set

    def get_variant(self, name: str) -> Optional[PopulationVariant]:
        for v in self.variants:
            if v.name == name:
                return v
        return None


if __name__ == '__main__':
    data_dir = get_data_dir()
    if not os.path.isdir(data_dir):
        print(f"Data directory not found: {data_dir}")
    else:
        # Load genes
        genes_path = os.path.join(data_dir, 'genes.xml')
        if os.path.exists(genes_path):
            gene_set = GeneSet.load(genes_path)
            print(f"Gene definitions: {len(gene_set.genes)}")
            # print first 3
            for g in gene_set.genes[:3]:
                print(f"  {g.name}: m={g.mutation_rate}, s={g.scale}, values={g.values}")
        # Load populations
        pop_path = os.path.join(data_dir, 'pop.xml')
        if os.path.exists(pop_path):
            pop_set = PopulationSet.load(pop_path)
            print(f"\nPopulation variants: {len(pop_set.variants)}")
            for v in pop_set.variants:
                print(f"  {v.name}: {len(v.overrides)} gene overrides")
                # print first 2 overrides
                for ov in v.overrides[:2]:
                    print(f"    {ov.name}: {ov.values}")
