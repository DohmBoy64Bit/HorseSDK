"""
Disassemble parts of save function
"""
import struct
import capstone

with open("Horsey.exe", "rb") as f:
    data = f.read()

pe_offset = struct.unpack('<I', data[0x3C:0x40])[0]
num_sections = struct.unpack('<H', data[pe_offset + 6:pe_offset + 8])[0]
opt_header_size = struct.unpack('<H', data[pe_offset + 20:pe_offset + 22])[0]

sections_start = pe_offset + 24 + opt_header_size

for i in range(num_sections):
    section = data[sections_start + i * 40:sections_start + (i + 1) * 40]
    name = section[:8].rstrip(b'\x00').decode('utf-8', errors='ignore')
    if name == ".text":
        text_rva = struct.unpack('<I', section[0x0C:0x10])[0]
        text_offset = struct.unpack('<I', section[0x14:0x18])[0]
        break

# Save function
save_rva = 0x6DAB0
file_offset = text_offset + (save_rva - text_rva)

print("=== Save Function Part 1 (0x6DAB0 - 0x6DCB0) ===")
code1 = data[file_offset:file_offset + 0x200]
md = capstone.Cs(capstone.CS_ARCH_X86, capstone.CS_MODE_64)
for insn in md.disasm(code1, save_rva):
    print(f"0x{insn.address:X}: {insn.mnemonic:10s} {insn.op_str}")

print("\n=== Save Function Part 2 (0x6DCB0 - 0x6DEB0) ===")
code2 = data[file_offset + 0x200:file_offset + 0x400]
for insn in md.disasm(code2, save_rva + 0x200):
    print(f"0x{insn.address:X}: {insn.mnemonic:10s} {insn.op_str}")

print("\n=== Save Function Part 3 (0x6DEB0 - 0x6E0B0) ===")
code3 = data[file_offset + 0x400:file_offset + 0x600]
for insn in md.disasm(code3, save_rva + 0x400):
    print(f"0x{insn.address:X}: {insn.mnemonic:10s} {insn.op_str}")
