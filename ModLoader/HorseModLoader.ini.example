; Copy to Game\HorseModLoader.ini (next to Horsey.exe)
[loader]
console=1
overlay=0
load_example_mod=1
; Loader-owned hooks (comma-separated catalog names). example_mod hooks money by default.
auto_hooks=
; Legacy: same as auto_hooks=GainMoney,SpendMoney
auto_hook_gain=0
; Explicit load order (optional). If set, only these DLLs are loaded, in order.
mods_order=example_mod.dll
; Per-mod enable (stem without .dll): mod_example_mod=0 disables example_mod
; mod_other_mod=1
